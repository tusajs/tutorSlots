# Copy this file to bot.env (next to build.gradle.kts) and fill in the values.
# bot.env is in .gitignore — never commit real tokens.

# Token from @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Google Cloud API key with "Google Sheets API" enabled
GOOGLE_API_KEY=AIza-your-key-here

# Full link to the schedule (the sheet must be shared as "Anyone with the link: Viewer")
SPREADSHEET=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# Optional: sheet name and range. Without it the first sheet is used.
# SHEET_RANGE=Лист1!A1:H16

# Optional: your Telegram ID (send /id to the bot) — enables /stats for you only
# TUTOR_ID=123456789

# Optional: shown under the picture as "Чтобы записаться, напишите ..."
# TUTOR_CONTACT=@your_username

# Optional: hide free slots that start earlier than this, in the CLIENT's time (default 08:00)
# EARLIEST_START=08:00

# Optional: HTTP proxy host:port, if Telegram or Google are not reachable directly
# PROXY=127.0.0.1:8080

# Optional: where users.json and the cached snapshot are stored (default: data)
# DATA_DIR=data
